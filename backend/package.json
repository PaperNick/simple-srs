{
  "name": "@simple-srs/backend",
  "version": "1.0.0",
  "description": "Simple SRS backend: Express API + SQLite + SRS scheduling.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "format": "prettier --write 'src/**/*.js' 'scripts/**/*.js' 'tests/**/*.js'"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
