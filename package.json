{
  "name": "simple-srs",
  "version": "1.0.0",
  "description": "A dataset-driven spaced-repetition and practice app for learning Vocabulary",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start.mjs",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:e2e",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "npm --prefix e2e test",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:e2e",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:e2e": "npm --prefix e2e run typecheck",
    "format": "npm run format:root && npm run format:shared && npm run format:backend && npm run format:frontend && npm run format:e2e",
    "format:root": "prettier --write '*.{js,mjs,cjs,ts,css,html,json}'",
    "format:shared": "prettier --write 'shared/**/*.{ts,css,html,json}'",
    "format:backend": "prettier --write 'backend/**/*.{js,jsx,mjs,cjs,ts,tsx,css,html,json}'",
    "format:frontend": "prettier --write 'frontend/**/*.{js,jsx,mjs,cjs,ts,tsx,css,html,json}'",
    "format:e2e": "prettier --write 'e2e/**/*.{js,jsx,mjs,cjs,ts,tsx,css,html,json}'",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6"
  }
}
